<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="pas.plugins.preauth">
  
  <include package=".browser" />  

  <genericsetup:registerProfile
      name="default"
      title="PreAuth Plugin for PAS - Zope 2 Base Installation"
      directory="profiles/default"
      description="Extension profile for pas.plugins.preauth Zope Base."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />


      <!-- TODO: Esto de dónde sale? 
      No estaba antes y no existe el archivo -->
      
<!--   <adapter
  name="oauthtokenretriever"
  factory=".oauth2.oauthTokenRetriever" /> -->

</configure>
